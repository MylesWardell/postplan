{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    ".local/**",
    "bun.lock",
    "**/routeTree.gen.ts",
    ".agents/skills/**",
    ".claude/**",
    "**/.wrangler/**",
    "packages/cloudflare/generated/**",
    "packages/cloudflare/env.d.ts"
  ]
}
