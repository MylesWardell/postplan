  app = "123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/postplan-app@sha256:REPLACE_WITH_64_HEX_DIGEST"
  cleanup = "123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/postplan-cleanup@sha256:REPLACE_WITH_64_HEX_DIGEST"
