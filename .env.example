DATABASE_PATH=./data/postplan.sqlite
AWS_S3_BUCKET_NAME=postplan-local
AWS_DEFAULT_REGION=ap-southeast-2
POSTPLAN_PUBLIC_BASE_URL=http://localhost:3000
POSTPLAN_BOOTSTRAP_API_KEY=replace-with-a-random-key
NODE_ENV=development
TRUST_PROXY=false
CLIENT_IP_SOURCE=req-ip
# Local S3-compatible storage only; omit these on EC2 to use the instance role.
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=replace-with-local-access-key
AWS_SECRET_ACCESS_KEY=replace-with-local-secret-key
# Optional dashboard login:
# POSTPLAN_SESSION_SECRET=replace-with-a-long-random-secret
# POSTPLAN_ALLOWED_LOGIN_DOMAINS=example.com,test.dev

# Set all four table names to use DynamoDB instead of SQLite.
# POSTPLAN_IDENTITY_TABLE=postplan-identity
# POSTPLAN_PLANS_TABLE=postplan-plans
# POSTPLAN_RECORDS_TABLE=postplan-records
# POSTPLAN_RATE_LIMITS_TABLE=postplan-limits
# POSTPLAN_DYNAMODB_ENDPOINT=http://localhost:8000
# DynamoDB retention: days since last successful upload; 0 disables expiry.
PLAN_RETENTION_DAYS=90
# Restrict uploads to API keys for a private team deployment.
POSTPLAN_ALLOW_ANONYMOUS_UPLOADS=false
# On Lambda, load existing SSM SecureStrings before starting the server.
# POSTPLAN_SESSION_SECRET_PARAMETER_ARN=arn:aws:ssm:ap-southeast-2:123456789012:parameter/postplan/session
# POSTPLAN_BOOTSTRAP_SECRET_PARAMETER_ARN=arn:aws:ssm:ap-southeast-2:123456789012:parameter/postplan/bootstrap
# Set only behind the Lambda Web Adapter with API Gateway HTTP API.
# POSTPLAN_API_GATEWAY=true
