DATABASE_PATH=./data/postplan.sqlite
AWS_S3_BUCKET_NAME=postplan-local
AWS_DEFAULT_REGION=ap-southeast-2
POSTPLAN_PUBLIC_BASE_URL=http://localhost:3000
POSTPLAN_BOOTSTRAP_API_KEY=replace-with-a-random-key
NODE_ENV=development
TRUST_PROXY=false
CLIENT_IP_SOURCE=req-ip
# Local S3-compatible storage only; omit these on EC2 to use the instance role.
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=replace-with-local-access-key
AWS_SECRET_ACCESS_KEY=replace-with-local-secret-key
# Optional dashboard login:
# POSTPLAN_SESSION_SECRET=replace-with-a-long-random-secret
# POSTPLAN_ALLOWED_LOGIN_DOMAINS=abx.com,kinesis.money
