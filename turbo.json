{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "//#quality": {
      "dependsOn": ["//#lint:root", "//#format:root"]
    },
    "//#quality:fix": {
      "dependsOn": ["//#lint:root:fix", "//#format:root:fix"]
    },
    "//#lint:root": {
      "dependsOn": [
        "@postplan/lambda#build",
        "@postplan/store-drizzle#build",
        "@postplan/store-dynamodb#build",
        "@postplan/cloudflare#cf:types",
        "@postplan/html-validator#cf:types",
        "@postplan/cloudflare-upload#cf:types"
      ]
    },
    "//#lint:root:fix": {
      "dependsOn": [
        "@postplan/lambda#build",
        "@postplan/store-drizzle#build",
        "@postplan/store-dynamodb#build",
        "@postplan/cloudflare#cf:types",
        "@postplan/html-validator#cf:types",
        "@postplan/cloudflare-upload#cf:types"
      ],
      "cache": false
    },
    "//#format:root": {},
    "//#format:root:fix": {
      "dependsOn": ["//#lint:root:fix"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/clean.ts",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "env": ["POSTPLAN_RUNTIME", "POSTPLAN_DATABASE", "POSTPLAN_CLOUDFLARE_CONFIG"],
      "outputs": ["dist/**", "bin/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "cf:build": {
      "dependsOn": ["^build"],
      "env": ["POSTPLAN_DATABASE", "POSTPLAN_CLOUDFLARE_CONFIG"],
      "cache": false
    },
    "cf:test": {
      "dependsOn": ["^build", "cf:types"],
      "cache": false
    },
    "cf:types": {
      "cache": false
    }
  }
}
