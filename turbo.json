{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "//#quality": {
      "dependsOn": ["//#lint:root", "//#format:root"]
    },
    "//#quality:fix": {
      "dependsOn": ["//#lint:root:fix", "//#format:root:fix"]
    },
    "//#lint:root": {
      "dependsOn": ["@postplan/store-drizzle#build", "@postplan/store-dynamodb#build"]
    },
    "//#lint:root:fix": {
      "dependsOn": ["@postplan/store-drizzle#build", "@postplan/store-dynamodb#build"],
      "cache": false
    },
    "//#format:root": {},
    "//#format:root:fix": {
      "dependsOn": ["//#lint:root:fix"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/clean.ts",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["dist/**", "bin/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
