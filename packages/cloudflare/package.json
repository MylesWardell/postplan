{
  "name": "@postplan/cloudflare",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "cf:types": "wrangler types --config wrangler.jsonc env.d.ts",
    "cf:build": "POSTPLAN_RUNTIME=cloudflare vite build ../../apps/web --config ../../apps/web/vite.config.ts",
    "cf:dev": "POSTPLAN_RUNTIME=cloudflare vite ../../apps/web --config ../../apps/web/vite.config.ts",
    "cf:test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "cf:initialize": "bun deploy/initialize.ts"
  },
  "dependencies": {
    "@orpc/cloudflare": "catalog:",
    "@orpc/server": "catalog:",
    "@postplan/store": "workspace:*",
    "@postplan/store-drizzle": "workspace:*",
    "@postplan/web": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/vitest-plugin": "1.1.13",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "4.1.0",
    "wrangler": "4.135.0",
    "zod": "catalog:"
  }
}
