{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "postplan-cloudflare-experiment",
  "main": "worker.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "POSTPLAN_DATABASE": "sqlite",
    "POSTPLAN_PUBLIC_BASE_URL": "http://localhost:5173",
    "EXPERIMENT_LOCAL": "true",
    "REQUEST_ID_HEADER": "x-request-id",
    "CLIENT_IP_SOURCE": "req-ip",
    "TRUST_PROXY": "false",
  },
  "d1_databases": [
    {
      "binding": "POSTPLAN_DB",
      "database_name": "postplan-cloudflare-experiment",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../store-drizzle/drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "HTML_BUCKET",
      "bucket_name": "postplan-cloudflare-experiment",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITS",
        "class_name": "RateLimit",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimit"],
    },
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "secrets": {
    "required": ["EXPERIMENT_TOKEN"],
  },
}
