{
  "name": "postplan-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "bun scripts/setup/link-skills.ts",
    "link-skills": "bun scripts/setup/link-skills.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "start": "bun apps/server/dist/src/index.js",
    "lint": "oxlint --deny-warnings apps packages scripts",
    "lint:fix": "oxlint --fix apps packages scripts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint && turbo run typecheck test",
    "pack:cli": "turbo run build --filter=postplan... && cd apps/cli && bun pm pack --ignore-scripts --destination ../../dist",
    "db:generate": "bun run --filter @postplan/server db:generate",
    "db:migrate": "bun run --filter @postplan/server build && bun apps/server/dist/src/db/migrate.js"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^22.20.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "tsdown": "0.23.0",
    "turbo": "2.10.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.20.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "esbuild"
  ]
}
