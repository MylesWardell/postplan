{
  "name": "postplan-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "start": "pnpm --filter @postplan/server start",
    "lint": "oxlint --deny-warnings apps packages",
    "lint:fix": "oxlint --fix apps packages",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && turbo run typecheck test",
    "pack:cli": "pnpm --filter postplan pack --pack-destination ../../dist"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.22.0"
}
