{
  "name": "postplan-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "bun scripts/setup/link-skills.ts",
    "link-skills": "bun scripts/setup/link-skills.ts",
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "start": "turbo run start --filter=@postplan/web",
    "lint": "turbo run lint:root",
    "lint:fix": "turbo run lint:root:fix",
    "lint:root": "oxlint --deny-warnings apps packages scripts",
    "lint:root:fix": "oxlint --fix apps packages scripts",
    "format": "turbo run format:root",
    "format:fix": "turbo run format:root:fix",
    "format:root": "oxfmt --check",
    "format:root:fix": "oxfmt .",
    "check": "turbo run quality test",
    "pack:cli": "turbo run build --filter=postplan... && cd apps/cli && bun pm pack --ignore-scripts --destination ../../dist",
    "db:generate": "bun run --filter @postplan/web db:generate",
    "db:migrate": "bun run --filter @postplan/web build && bun apps/web/dist/src/db/migrate.js"
  },
  "devDependencies": {
    "@postplan/store": "workspace:*",
    "@postplan/store-drizzle": "workspace:*",
    "@postplan/store-dynamodb": "workspace:*",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/bun": "1.4.2",
    "@types/node": "^26.5.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.23.0",
    "turbo": "2.10.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=26.8.2"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild"
  ]
}
