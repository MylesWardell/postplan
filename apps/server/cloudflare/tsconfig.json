{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "types": ["node", "vite/client", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "./**/*.ts",
    "../vite.cloudflare.config.ts",
    "../vitest.cloudflare.config.ts",
    "../src/frontend/**/*.ts",
    "../src/frontend/**/*.tsx"
  ],
  "exclude": ["./dist", "./generated"]
}
