{
  "name": "@postplan/server",
  "version": "0.0.4",
  "private": true,
  "files": [
    "dist/",
    "drizzle/"
  ],
  "type": "module",
  "scripts": {
    "build": "bun ../../scripts/clean.ts && bun --bun vite build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./test",
    "start": "bun dist/src/index.js",
    "dev": "bun --bun vite dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun dist/src/db/migrate.js",
    "preview": "bun --bun vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.835.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@orpc/client": "2.0.0-beta.35",
    "@orpc/contract": "2.0.0-beta.35",
    "@orpc/evlog": "2.0.0-beta.35",
    "@orpc/json-schema": "2.0.0-beta.35",
    "@orpc/openapi": "2.0.0-beta.35",
    "@orpc/opentelemetry": "2.0.0-beta.35",
    "@orpc/ratelimit": "2.0.0-beta.35",
    "@orpc/server": "2.0.0-beta.35",
    "@orpc/zod": "2.0.0-beta.35",
    "@postplan/api": "workspace:*",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.53",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.2.3",
    "nanoid": "^5.1.5",
    "parse5": "^7.3.0",
    "proxy-addr": "^2.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "0.31.10",
    "vite": "^8.3.0"
  }
}
