{
  "name": "@postplan/server",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js",
    "start": "node --enable-source-maps dist/src/server.js",
    "dev": "node --import tsx --watch src/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.835.0",
    "@postplan/core": "workspace:*",
    "commander": "^14.0.0",
    "express": "^5.1.0",
    "jose": "^6.2.3",
    "nanoid": "^5.1.5",
    "pg": "^8.16.2"
  }
}
