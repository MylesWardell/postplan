{
  "name": "postplan",
  "version": "0.0.4",
  "private": false,
  "license": "MIT",
  "bin": {
    "postplan": "./bin/postplan.js"
  },
  "files": [
    "bin/",
    "skills/",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --external:commander --external:parse5 --sourcemap --outfile=bin/postplan.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@postplan/core": "workspace:*"
  }
}
